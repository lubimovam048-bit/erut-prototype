{
  "name": "erut-monitoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "vue-tsc --noEmit",
    "test:data": "node --experimental-strip-types --test tests/data.test.ts",
    "test:ui": "vitest run",
    "test": "npm run test:data && npm run test:ui",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "start": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test:server": "node --experimental-strip-types --test tests/server.test.ts",
    "check:server": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --types node --skipLibCheck --strict server/app.ts server/start.ts server/public.ts"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@lucide/vue": "^1.47.0",
    "maplibre-gl": "^6.11.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  }
}
